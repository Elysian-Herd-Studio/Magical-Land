{
  "schemaVersion": 1,
  "id": "magicaland",
  "version": "${version}",
  "name": "Magical Land",
  "description": "Create your own pony in Minecraft with custom colors, cutie marks and animations.",
  "authors": [
    "JessDaodao",
    "MayHooves"
  ],
  "contact": {
    "issues": "https://github.com/Elysian-Herd-Studio/Magical-Land/issues",
    "sources": "https://github.com/Elysian-Herd-Studio/Magical-Land"
  },
  "license": "MIT",
  "icon": "assets/magicaland/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "top.elysianherd.magicaland.client.DataGenerator"
    ],
    "client": [
      "top.elysianherd.magicaland.client.Client"
    ],
    "main": [
      "top.elysianherd.magicaland.Magical_Land"
    ],
    "modmenu": [
      "top.elysianherd.magicaland.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "magicaland.mixins.json",
    {
      "config": "magicaland.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "magicaland.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "geckolib": ">=4.7"
  }
}
